{
  "version": 3,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "${sourceDir}/cmake/arm-none-eabi.cmake"
    },
    {
      "name": "debug",
      "inherits": "base",
      "displayName": "Debug (custom board)",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release (custom board)",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "bluepill-debug",
      "inherits": "debug",
      "displayName": "Debug (Blue Pill prototype)",
      "cacheVariables": { "BOARD": "bluepill" }
    },
    {
      "name": "bluepill-release",
      "inherits": "release",
      "displayName": "Release (Blue Pill prototype)",
      "cacheVariables": { "BOARD": "bluepill" }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "bluepill-debug", "configurePreset": "bluepill-debug" },
    { "name": "bluepill-release", "configurePreset": "bluepill-release" }
  ]
}
