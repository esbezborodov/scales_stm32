{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build",
            "type": "shell",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "command": "./build.sh",
            "problemMatcher": [],
            "detail": "Build project"
        },
        {
            "label": "Clean",
            "type": "shell",
            "group": "build",
            "command": "rm -rf build",
            "problemMatcher": [],
            "detail": "Clean project"
        },
        {
            "label": "Test",
            "type": "shell",
            "command": "./test.sh",
            "group": "test",
            "problemMatcher": [],
            "detail": "Build and run host unit tests"
        },
        {
            "type": "shell",
            "label": "Flash",
            "command": "./flash.sh",
            "problemMatcher": [],
            "group": "build",
            "detail": "Build project and flash firmware"
        },
        {
            "type": "shell",
            "label": "Erase",
            "command": "openocd",
            "args": [
                "-f",
                "firmware/debug/openocd.cfg",
                "-c",
                "init; reset halt; stm32f1x mass_erase 0; exit"
            ],
            "detail": "Mass erase of chip"
        }
    ]
}
