  69:Core/common/lcd_i2c.c **** 	}
  70:Core/common/lcd_i2c.c **** 	LCD_command(lcd_i2c, LCD_DISPLAYCONTROL|LCD_DISPLAYON|lcd_i2c->displaycontrol);
