  63:Core/common/lcd_i2c.c **** void LCD_Blink(LCD_I2C_t *lcd_i2c, uint8_t on)
  64:Core/common/lcd_i2c.c **** {
  65:Core/common/lcd_i2c.c **** 	if (on) {
  66:Core/common/lcd_i2c.c **** 		lcd_i2c->displaycontrol |= LCD_BLINKON;
  67:Core/common/lcd_i2c.c **** 	} else {
