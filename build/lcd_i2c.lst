 106:Core/common/lcd_i2c.c **** /**
 107:Core/common/lcd_i2c.c ****  * Send command to display
 108:Core/common/lcd_i2c.c ****  * @par *lcd_i2c - Pointer to @ref LCD_I2C_t working lcd_i2c struct
 109:Core/common/lcd_i2c.c ****  * @par command  - command
 110:Core/common/lcd_i2c.c ****  * @retval 1 - success, 0 - error divice not responding
 111:Core/common/lcd_i2c.c ****  */
 112:Core/common/lcd_i2c.c **** uint8_t LCD_command(LCD_I2C_t *lcd_i2c, uint8_t command)
 113:Core/common/lcd_i2c.c **** {
 114:Core/common/lcd_i2c.c **** 	return LCD_send(lcd_i2c, command, 0);
 115:Core/common/lcd_i2c.c **** }
